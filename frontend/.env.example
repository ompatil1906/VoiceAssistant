# EMMA voice console frontend
# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser.

# WebSocket endpoint of the EMMA gateway (no query parameters).
# Also used to derive the gateway HTTP origin for the LiveKit token request.
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8000/ws/exotel

# Where live calls are carried:
#   livekit    real WebRTC call: the browser joins an EMMA LiveKit room and the
#              gateway agent runs the speech pipeline (default)
#   websocket  the raw /ws/exotel media-stream transport (16 kHz PCM16)
NEXT_PUBLIC_VOICE_TRANSPORT=livekit

# Optional: gateway HTTP origin for POST /api/voice/token.
# Defaults to NEXT_PUBLIC_VOICE_WS_URL with ws→http and the path dropped.
# NEXT_PUBLIC_VOICE_GATEWAY_HTTP=http://localhost:8000

# Optional: LiveKit URL if the token response does not carry one.
# NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
