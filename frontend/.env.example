# EMMA voice console frontend
# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser.

# WebSocket endpoint of the EMMA gateway (no query parameters).
# Used only when NEXT_PUBLIC_VOICE_TRANSPORT=websocket.
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8000/ws/exotel

# Where live calls are carried:
#   livekit    real WebRTC call: the browser joins an EMMA LiveKit room and
#              scripts/run_agent_session.py answers it (default)
#   websocket  the raw /ws/exotel media-stream transport (16 kHz PCM16)
NEXT_PUBLIC_VOICE_TRANSPORT=livekit

# HTTP origin that serves POST /api/voice/token. This repository ships that
# route in the Next app itself, so with `next dev` on port 3000 it is:
NEXT_PUBLIC_VOICE_GATEWAY_HTTP=https://voiceassistant-406s.onrender.com

# Browser-side speech recognition is off by default: it hears EMMA's own voice
# without echo cancellation and makes the assistant answer itself. Leave this
# unset unless the agent's server-side transcription is unavailable.
# NEXT_PUBLIC_BROWSER_STT=1

# LiveKit endpoint and the credentials used by /api/voice/token to mint room
# tokens. The secret stays on the server; it must match the LiveKit server.
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=emma_local
LIVEKIT_API_SECRET=replace-with-your-livekit-secret
